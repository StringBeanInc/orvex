{
  "name": "orvex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-orvex",
    "test:rules": "node --test emulator-tests/security.test.mjs emulator-tests/directory-rules.test.mjs",
    "test:auth": "playwright test --config emulator-tests/playwright.config.ts --output tmp/auth-test-results",
    "test": "playwright test",
    "test:signup-disabled": "playwright test --config emulator-tests/disabled.config.ts --output tmp/signup-disabled-results"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
