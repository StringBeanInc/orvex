rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified(){return request.auth != null && request.auth.token.email_verified == true;}
  function member(cid){let m=get(/databases/$(database)/documents/organizations/$(cid)/members/$(request.auth.uid)).data;return verified() && m.uid==request.auth.uid && m.companyId==cid && m.active==true && m.get('status','active')=='active' && (m.role in ['Owner','Admin','Technician'] || (m.get('permissionSchema',0)==1 && m.role in ['Administrator','Manager','Office Staff']));}
  function bootstrap(cid){return verified() && exists(/databases/$(database)/documents/betaEnrollment/$(request.auth.token.email.lower())) && get(/databases/$(database)/documents/betaEnrollment/$(request.auth.token.email.lower())).data.enabled == true && get(/databases/$(database)/documents/betaEnrollment/$(request.auth.token.email.lower())).data.expiresAt > request.time && exists(/databases/$(database)/documents/platformConfig/publicSignup) && get(/databases/$(database)/documents/platformConfig/publicSignup).data.enabled == true && verified() && !exists(/databases/$(database)/documents/organizations/$(cid)) && !exists(/databases/$(database)/documents/users/$(request.auth.uid)) && !exists(/databases/$(database)/documents/organizations/$(cid)/members/$(request.auth.uid)) && !exists(/databases/$(database)/documents/organizations/$(cid)/employees/$(request.auth.uid)) && getAfter(/databases/$(database)/documents/organizations/$(cid)).data.ownerUid == request.auth.uid && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid && getAfter(/databases/$(database)/documents/organizations/$(cid)/members/$(request.auth.uid)).data.role == 'Owner' && getAfter(/databases/$(database)/documents/organizations/$(cid)/employees/$(request.auth.uid)).data.role == 'Owner';}
  match /platformConfig/publicSignup { allow get: if true; }
  match /users/{uid} {
   match /companyMemberships/{cid} {allow get,list: if verified() && request.auth.uid==uid;}
   allow get: if verified() && request.auth.uid == uid;
   allow create: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['companyId','createdAt']) && request.resource.data.createdAt == request.time && bootstrap(request.resource.data.companyId);
  }
  match /organizations/{cid} {
   function permitted(p){let m=get(/databases/$(database)/documents/organizations/$(cid)/members/$(request.auth.uid)).data;return member(cid) && (m.role=='Owner' || (m.role=='Administrator' && p in ['directory.read','directory.write','workOrders.read','workOrders.write']) || (m.role=='Manager' && p in ['directory.read','workOrders.read','workOrders.write']) || (m.role=='Office Staff' && p in ['directory.read','directory.write','workOrders.read']) || (m.role in ['Administrator','Manager','Office Staff','Technician'] && m.get('permissionSchema',0)==1 && p in m.get('permissions',[])));}
   function catalogAccess(){return permitted('pricing.manage') && permitted('costs.read');}
   function owner(){return member(cid) && get(/databases/$(database)/documents/organizations/$(cid)/members/$(request.auth.uid)).data.role == 'Owner';}
   function text(v,limit){return v is string && v.size() <= limit;}
   function required(v,limit){return text(v,limit) && v.size()>0 && v.matches('.*[^ ].*');}
   function meta(d,id){return d.id == id && d.companyId == cid && d.schemaVersion == 1 && d.revision is int && d.revision>0 && d.updatedAt == request.time && d.updatedBy == request.auth.uid && ((d.deletedAt == null && d.deletedBy == null && d.recoverUntil == null) || (d.deletedAt == request.time && d.deletedBy == request.auth.uid && d.recoverUntil is timestamp && d.recoverUntil >= request.time + duration.value(29,'d') && d.recoverUntil <= request.time + duration.value(31,'d')));}
   function fresh(d){return d.createdAt == request.time && d.createdBy == request.auth.uid && d.revision == 1 && d.deletedAt == null;}
   function changed(d){return d.createdAt == resource.data.createdAt && d.createdBy == resource.data.createdBy && d.revision == resource.data.revision+1 && resource.data.deletedAt == null;}
   function customerShape(d,id){return d.keys().hasOnly(['id','companyId','schemaVersion','revision','createdAt','createdBy','updatedAt','updatedBy','deletedAt','deletedBy','recoverUntil','name','contact','email','phone','streetAddress','addressLine2','city','state','postalCode','country','propertyCount','relationshipMutationId']) && meta(d,id) && required(d.name,160) && required(d.contact,160) && required(d.phone,80) && text(d.email,254) && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') && text(d.streetAddress,300) && text(d.addressLine2,160) && text(d.city,120) && text(d.state,120) && text(d.postalCode,30) && text(d.country,120) && d.propertyCount is int && d.propertyCount>=0 && text(d.relationshipMutationId,128);}
   function propertyShape(d,id){return d.keys().hasOnly(['id','companyId','schemaVersion','revision','createdAt','createdBy','updatedAt','updatedBy','deletedAt','deletedBy','recoverUntil','name','address','city','state','postalCode','type','customerId','workOrderCount','workOrderMutationId']) && d.get('workOrderCount',0) is int && d.get('workOrderCount',0)>=0 && text(d.get('workOrderMutationId',''),128) && meta(d,id) && required(d.name,160) && required(d.address,300) && text(d.city,120) && text(d.state,120) && text(d.postalCode,30) && d.type in ['Office','Residential','Healthcare','Commercial','Industrial'] && required(d.customerId,128);}
   function wasLinked(pid,customer){return exists(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)) && get(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.deletedAt == null && get(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.customerId == customer;}
   function nowLinked(pid,customer){return getAfter(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.deletedAt == null && getAfter(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.customerId == customer;}
   function countChange(d,id){return (d.propertyCount == resource.data.propertyCount && d.relationshipMutationId == resource.data.relationshipMutationId) || (d.deletedAt == null && d.diff(resource.data).affectedKeys().hasOnly(['propertyCount','relationshipMutationId','revision','updatedAt','updatedBy']) && ((!wasLinked(d.relationshipMutationId,id) && nowLinked(d.relationshipMutationId,id) && d.propertyCount == resource.data.propertyCount+1) || (wasLinked(d.relationshipMutationId,id) && !nowLinked(d.relationshipMutationId,id) && d.propertyCount == resource.data.propertyCount-1)));}
   function activeCustomer(customer){return getAfter(/databases/$(database)/documents/organizations/$(cid)/customers/$(customer)).data.deletedAt == null && getAfter(/databases/$(database)/documents/organizations/$(cid)/customers/$(customer)).data.companyId == cid;}
   function countDelta(customer,pid,delta){return getAfter(/databases/$(database)/documents/organizations/$(cid)/customers/$(customer)).data.propertyCount == get(/databases/$(database)/documents/organizations/$(cid)/customers/$(customer)).data.propertyCount+delta && getAfter(/databases/$(database)/documents/organizations/$(cid)/customers/$(customer)).data.relationshipMutationId == pid;}
   function woLinkedBefore(wid,pid){return exists(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(wid)) && get(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(wid)).data.propertyId == pid;}
   function woLinkedAfter(wid,pid){return getAfter(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(wid)).data.propertyId == pid;}
   function woCountChange(d,pid){return (d.get('workOrderCount',0) == resource.data.get('workOrderCount',0) && d.get('workOrderMutationId','') == resource.data.get('workOrderMutationId','')) || (d.deletedAt == null && d.diff(resource.data).affectedKeys().hasOnly(['workOrderCount','workOrderMutationId','revision','updatedAt','updatedBy']) && ((!woLinkedBefore(d.workOrderMutationId,pid) && woLinkedAfter(d.workOrderMutationId,pid) && d.workOrderCount == resource.data.get('workOrderCount',0)+1) || (woLinkedBefore(d.workOrderMutationId,pid) && !woLinkedAfter(d.workOrderMutationId,pid) && d.workOrderCount == resource.data.get('workOrderCount',0)-1)));}
   function woCountDelta(pid,wid,delta){return getAfter(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.workOrderCount == get(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.get('workOrderCount',0)+delta && getAfter(/databases/$(database)/documents/organizations/$(cid)/properties/$(pid)).data.workOrderMutationId == wid;}
   function calendarDate(v){let parsed=v==''?timestamp.date(2000,1,1):timestamp.date(int(v.split('-')[0]),int(v.split('-')[1]),int(v.split('-')[2]));return v=='' || (v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && parsed>=timestamp.date(1900,1,1) && parsed<=timestamp.date(2200,12,31));}
   function woShape(d,id){return d.keys().hasOnly(['id','companyId','schemaVersion','revision','number','customerId','propertyId','title','description','serviceCategory','priority','status','assignedTechnicianId','scheduledDate','dueDate','internalNotes','createdAt','createdBy','updatedAt','updatedBy','lastActivityId']) && d.id == id && d.companyId == cid && d.schemaVersion == 1 && d.revision is int && d.revision>0 && d.number is int && d.number>0 && d.number<=1000000000 && required(d.title,200) && required(d.description,12000) && required(d.serviceCategory,80) && d.priority in ['Low','Normal','High','Emergency'] && d.status in ['New','Scheduled','In Progress','On Hold','Completed','Closed'] && required(d.customerId,128) && required(d.propertyId,128) && text(d.assignedTechnicianId,128) && text(d.internalNotes,12000) && required(d.lastActivityId,128) && calendarDate(d.scheduledDate) && calendarDate(d.dueDate) && (d.scheduledDate=='' || d.dueDate=='' || d.dueDate>=d.scheduledDate) && (d.status!='Scheduled'||d.scheduledDate!='') && d.updatedAt == request.time && d.updatedBy == request.auth.uid;}
   function assignedEmployee(uid){let e=get(/databases/$(database)/documents/organizations/$(cid)/employees/$(uid)).data;let m=get(/databases/$(database)/documents/organizations/$(cid)/members/$(uid)).data;return e.companyId==cid && e.uid==uid && e.get('active',true)==true && m.active==true && m.get('status','active')=='active';}
   function woReferences(d){let p=getAfter(/databases/$(database)/documents/organizations/$(cid)/properties/$(d.propertyId)).data;return activeCustomer(d.customerId) && p.deletedAt==null && p.customerId==d.customerId && p.companyId==cid && (d.assignedTechnicianId=='' || assignedEmployee(d.assignedTechnicianId));}
   function woActivity(d){let e=getAfter(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(d.id)/activity/$(d.lastActivityId)).data;return e.revision==d.revision && e.actorUid==request.auth.uid && e.at==request.time;}
   function allocated(d){return getAfter(/databases/$(database)/documents/organizations/$(cid)/numberSequences/workOrders).data.lastWorkOrderId == d.id && d.number == getAfter(/databases/$(database)/documents/organizations/$(cid)/numberSequences/workOrders).data.nextNumber-1;}
   match /numberSequences/workOrders {
    allow get: if permitted('workOrders.write');
    function validSequence(d){return d.keys().hasOnly(['companyId','schemaVersion','nextNumber','revision','lastWorkOrderId','updatedAt','updatedBy']) && d.companyId == cid && d.schemaVersion == 1 && d.nextNumber is int && d.nextNumber>1 && d.nextNumber<=1000000001 && d.revision is int && d.updatedAt==request.time && d.updatedBy==request.auth.uid && required(d.lastWorkOrderId,128) && !exists(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(d.lastWorkOrderId)) && getAfter(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(d.lastWorkOrderId)).data.number==d.nextNumber-1 && getAfter(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(d.lastWorkOrderId)).data.createdAt==request.time;}
    allow create: if permitted('workOrders.write') && validSequence(request.resource.data) && request.resource.data.nextNumber==2 && request.resource.data.revision==1;
    allow update: if permitted('workOrders.write') && validSequence(request.resource.data) && request.resource.data.nextNumber==resource.data.nextNumber+1 && request.resource.data.revision==resource.data.revision+1;
   }
   function dispatchHeaderSafe(d,id){let p=/databases/$(database)/documents/organizations/$(cid)/dispatchBookings/$(id);return !exists(p) || get(p).data.active!=true || (d.assignedTechnicianId==resource.data.assignedTechnicianId && d.scheduledDate==resource.data.scheduledDate && d.propertyId==resource.data.propertyId && d.customerId==resource.data.customerId);}
   match /workOrders/{id} {
    allow read: if permitted('workOrders.read');
    allow create: if permitted('workOrders.write') && woShape(request.resource.data,id) && woReferences(request.resource.data) && request.resource.data.revision==1 && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid && allocated(request.resource.data) && woCountDelta(request.resource.data.propertyId,id,1) && woActivity(request.resource.data);
    allow update: if permitted('workOrders.write') && dispatchHeaderSafe(request.resource.data,id) && (!exists(/databases/$(database)/documents/organizations/$(cid)/financialWorkOrders/$(id)) || (request.resource.data.customerId==resource.data.customerId && request.resource.data.propertyId==resource.data.propertyId)) && woShape(request.resource.data,id) && woReferences(request.resource.data) && request.resource.data.revision==resource.data.revision+1 && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.number==resource.data.number && woActivity(request.resource.data) && (request.resource.data.propertyId==resource.data.propertyId || (woCountDelta(resource.data.propertyId,id,-1) && woCountDelta(request.resource.data.propertyId,id,1)));
    match /activity/{eventId} {
     allow read: if permitted('workOrders.read');
     function eventValid(e,old,next,creation){return e.keys().hasOnly(['id','companyId','workOrderId','revision','actorUid','at','created','statusChanged','priorityChanged','assignmentChanged','schedulingChanged','notesAdded','beforeStatus','afterStatus','beforePriority','afterPriority','beforeAssignment','afterAssignment','beforeScheduled','afterScheduled','beforeDue','afterDue','notes']) && e.id==eventId && e.companyId==cid && e.workOrderId==id && e.revision==next.revision && e.actorUid==request.auth.uid && e.at==request.time && next.updatedAt==request.time && next.lastActivityId==eventId && e.created==creation && e.statusChanged==(!creation && old.status!=next.status) && e.priorityChanged==(!creation && old.priority!=next.priority) && e.assignmentChanged==(!creation && old.assignedTechnicianId!=next.assignedTechnicianId) && e.schedulingChanged==(!creation && (old.scheduledDate!=next.scheduledDate || old.dueDate!=next.dueDate)) && e.notesAdded==(old.internalNotes!=next.internalNotes) && e.beforeStatus==old.status && e.afterStatus==next.status && e.beforePriority==old.priority && e.afterPriority==next.priority && e.beforeAssignment==old.assignedTechnicianId && e.afterAssignment==next.assignedTechnicianId && e.beforeScheduled==old.scheduledDate && e.afterScheduled==next.scheduledDate && e.beforeDue==old.dueDate && e.afterDue==next.dueDate && e.notes==next.internalNotes;}
     allow create: if permitted('workOrders.write') && (( !exists(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(id)) && eventValid(request.resource.data,{'status':'','priority':'','assignedTechnicianId':'','scheduledDate':'','dueDate':'','internalNotes':''},getAfter(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(id)).data,true)) || (exists(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(id)) && eventValid(request.resource.data,get(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(id)).data,getAfter(/databases/$(database)/documents/organizations/$(cid)/workOrders/$(id)).data,false)));
    }
   }

   allow get: if member(cid);
   allow create: if request.resource.data.keys().hasOnly(['name','ownerName','ownerUid','companyId','schemaVersion','createdAt','phone','timeZone']) && request.resource.data.get('phone','') is string && request.resource.data.get('phone','').size()<=40 && (request.resource.data.get('phone','')=='' || (request.resource.data.phone.matches('[+0-9() .-]{3,40}') && request.resource.data.phone.matches('.*[0-9].*'))) && request.resource.data.get('timeZone','America/Chicago') in ["UTC","America/New_York","America/Chicago","America/Denver","America/Los_Angeles","America/Phoenix","America/Anchorage","Pacific/Honolulu","America/Toronto","America/Vancouver","America/Mexico_City","America/Sao_Paulo","Europe/London","Europe/Paris","Europe/Berlin","Africa/Johannesburg","Asia/Dubai","Asia/Kolkata","Asia/Singapore","Asia/Tokyo","Australia/Sydney","Pacific/Auckland"] && request.resource.data.companyId == cid && request.resource.data.schemaVersion == 1 && request.resource.data.createdAt == request.time && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.matches('.*[^ \t\r\n].*') && request.resource.data.name.size() <= 120 && request.resource.data.ownerName is string && request.resource.data.ownerName.size() > 0 && request.resource.data.ownerName.matches('.*[^ \t\r\n].*') && request.resource.data.ownerName.size() <= 120 && bootstrap(cid);
   match /members/{uid} {
    allow get: if verified() && request.auth.uid == uid;
    allow create: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','companyId','role','active','createdAt']) && request.resource.data.uid == uid && request.resource.data.companyId == cid && request.resource.data.role == 'Owner' && request.resource.data.active == true && request.resource.data.createdAt == request.time && bootstrap(cid);
   }
   match /employees/{uid} {
    allow read: if owner();
    allow create: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','companyId','role','name','createdAt']) && request.resource.data.uid == uid && request.resource.data.companyId == cid && request.resource.data.role == 'Owner' && request.resource.data.name == getAfter(/databases/$(database)/documents/organizations/$(cid)).data.ownerName && request.resource.data.createdAt == request.time && bootstrap(cid);
   }
   match /customers/{id} {
    allow read: if permitted('directory.read');
    allow create: if permitted('directory.write') && customerShape(request.resource.data,id) && fresh(request.resource.data) && request.resource.data.propertyCount == 0 && request.resource.data.relationshipMutationId == '';
    allow update: if permitted('directory.write') && customerShape(request.resource.data,id) && changed(request.resource.data) && countChange(request.resource.data,id) && (request.resource.data.deletedAt == null || request.resource.data.propertyCount == 0);
   }
   match /properties/{id} {
    allow read: if permitted('directory.read');
    allow create: if permitted('directory.write') && propertyShape(request.resource.data,id) && fresh(request.resource.data) && request.resource.data.get('workOrderCount',0)==0 && request.resource.data.get('workOrderMutationId','')=='' && activeCustomer(request.resource.data.customerId) && countDelta(request.resource.data.customerId,id,1);
    allow update: if (permitted('directory.write') || (permitted('workOrders.write') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workOrderCount','workOrderMutationId','revision','updatedAt','updatedBy']))) && propertyShape(request.resource.data,id) && changed(request.resource.data) && woCountChange(request.resource.data,id) && (request.resource.data.deletedAt==null || request.resource.data.get('workOrderCount',0)==0) && (resource.data.get('workOrderCount',0)==0 || request.resource.data.customerId==resource.data.customerId) && ((request.resource.data.deletedAt != null && request.resource.data.customerId == resource.data.customerId && countDelta(resource.data.customerId,id,-1)) || (request.resource.data.deletedAt == null && activeCustomer(request.resource.data.customerId) && (request.resource.data.customerId == resource.data.customerId || (countDelta(resource.data.customerId,id,-1) && countDelta(request.resource.data.customerId,id,1)))));
   }
   // Phase 3C: bounded pricing documents; no existing work order fields are migrated.
   function cents(v){return v is int && v>=0 && v<=10000000;}
   function catalogRef(id){return /databases/$(database)/documents/organizations/$(cid)/pricingCatalog/$(id);}
   function catalogShape(d,id){return d.keys().hasOnly(['id','companyId','schemaVersion','revision','currency','createdAt','createdBy','updatedAt','updatedBy','lastEventId','standardSnapshot','overtimeSnapshot','kind','code','name','description','category','pricingMethod','unit','sellingPriceCents','overtimePriceCents','internalCostCents','purchaseCostCents','markupBps','supplier','durationMinutes','active']) && d.id==id && d.companyId==cid && d.schemaVersion==1 && d.currency=='USD' && d.revision is int && d.revision>0 && d.updatedBy==request.auth.uid && d.updatedAt==request.time && required(d.lastEventId,128) && d.code is string && d.code.matches('[-A-Z0-9_]{1,40}') && required(d.name,160) && required(d.description,2000) && required(d.category,80) && required(d.unit,40) && cents(d.sellingPriceCents) && cents(d.overtimePriceCents) && cents(d.purchaseCostCents) && text(d.supplier,160) && d.durationMinutes is int && d.durationMinutes>=0 && d.durationMinutes<=100000 && d.active is bool && d.standardSnapshot=={'kind':d.kind,'code':d.code,'description':d.description,'priceCents':d.sellingPriceCents} && d.overtimeSnapshot=={'kind':d.kind,'code':d.code,'description':d.description,'priceCents':d.overtimePriceCents} && ((d.kind=='service' && d.pricingMethod in ['fixed','hourly','unit'] && (d.pricingMethod!='hourly'||d.unit=='hour') && d.overtimePriceCents==0 && d.purchaseCostCents==0 && d.internalCostCents==null && d.markupBps==null && d.supplier=='') || (d.kind=='labor' && d.pricingMethod=='hourly' && d.unit=='hour' && d.purchaseCostCents==0 && d.markupBps==null && d.durationMinutes==0 && d.supplier=='' && (d.internalCostCents==null||cents(d.internalCostCents))) || (d.kind=='material' && d.pricingMethod=='unit' && d.overtimePriceCents==0 && d.internalCostCents==null && d.durationMinutes==0 && (d.markupBps==null || (d.markupBps is int && d.markupBps>=0 && d.markupBps<=100000 && d.sellingPriceCents==int((d.purchaseCostCents*(10000+d.markupBps)+5000) / 10000)))));}
   function codeMatches(d){return getAfter(/databases/$(database)/documents/organizations/$(cid)/catalogCodes/$(d.code)).data.itemId==d.id && getAfter(/databases/$(database)/documents/organizations/$(cid)/catalogCodes/$(d.code)).data.kind==d.kind;}
   function catalogAudit(d){let e=getAfter(/databases/$(database)/documents/organizations/$(cid)/pricingCatalog/$(d.id)/history/$(d.lastEventId)).data;return e.snapshot==d && e.at==request.time && e.actorUid==request.auth.uid;}
   match /catalogCodes/{code} {
    allow get: if catalogAccess();
    allow create: if catalogAccess() && request.resource.data.keys().hasOnly(['companyId','itemId','kind','createdAt','createdBy']) && request.resource.data.companyId==cid && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid && getAfter(catalogRef(request.resource.data.itemId)).data.code==code && getAfter(catalogRef(request.resource.data.itemId)).data.kind==request.resource.data.kind && getAfter(catalogRef(request.resource.data.itemId)).data.createdAt==request.time && !exists(catalogRef(request.resource.data.itemId));
   }
   match /pricingCatalog/{id} {
    allow read: if catalogAccess();
    allow create: if catalogAccess() && catalogShape(request.resource.data,id) && request.resource.data.revision==1 && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid && codeMatches(request.resource.data) && catalogAudit(request.resource.data);
    allow update: if catalogAccess() && catalogShape(request.resource.data,id) && request.resource.data.revision==resource.data.revision+1 && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.kind==resource.data.kind && request.resource.data.code==resource.data.code && codeMatches(request.resource.data) && catalogAudit(request.resource.data);
    match /history/{eventId} {
     allow read: if catalogAccess();
     allow create: if catalogAccess() && request.resource.data.keys().hasOnly(['id','companyId','itemId','revision','actorUid','at','beforePriceCents','beforeActive','snapshot']) && request.resource.data.id==eventId && request.resource.data.companyId==cid && request.resource.data.itemId==id && request.resource.data.actorUid==request.auth.uid && request.resource.data.at==request.time && request.resource.data.snapshot==getAfter(catalogRef(id)).data && request.resource.data.revision==getAfter(catalogRef(id)).data.revision && getAfter(catalogRef(id)).data.lastEventId==eventId && getAfter(catalogRef(id)).data.updatedAt==request.time && ((!exists(catalogRef(id)) && request.resource.data.beforePriceCents==null && request.resource.data.beforeActive==null) || (exists(catalogRef(id)) && request.resource.data.beforePriceCents==get(catalogRef(id)).data.sellingPriceCents && request.resource.data.beforeActive==get(catalogRef(id)).data.active));
    }
   }
   match /financialWorkOrders/{id} { allow get: if owner(); }
   // Financial reads require existing Phase 3C Owner authorization; all mutations use trusted backend commands.
   match /{financialCollection}/{financialId} {
    allow read: if financialCollection in ['estimates','invoices','changeOrders'] && owner();
    match /{financialChild}/{childId} {
     allow read: if financialCollection in ['estimates','invoices','changeOrders'] && financialChild in ['versions','events','payments','approvals'] && owner();
    }
   }
   // Dispatch timed bookings, availability, routes, locks and audit are backend-only.
   match /workOrderOperations/{id} {allow read,write: if false;}
   match /dispatchBookings/{id} {allow read,write: if false;}
   match /dispatchAvailability/{id} {allow read,write: if false;}
   match /dispatchRoutes/{id} {allow read,write: if false;}
   match /dispatchLocks/{id} {allow read,write: if false;}
   match /dispatchOperations/{id} {allow read,write: if false;}
   match /dispatchAudit/{id} {allow read,write: if false;}
   // Phase 3H is trusted-backend-only; no direct credential, secret or audit access.
   match /{integrationCollection}/{integrationId} {allow read,write: if false;}
   // Accounting mock/private state is available only through trusted emulator commands.
   match /{accountingCollection}/{accountingId} {allow read,write: if false;}
   // Timekeeping is accessed only through authenticated, company-scoped callable operations.
   // Includes immutable history, policies, sensitive coordinates and idempotency locks.
   match /{timeCollection}/{timeId} {
    allow read, write: if false;
   }
   // Pricing mutations use the trusted callable backend; direct client writes are denied.
   match /workOrders/{wid}/pricing/current { allow read: if owner(); }
   match /workOrders/{wid}/pricingHistory/{eventId} { allow read: if owner(); }
   match /{collection}/{id} {
    allow read: if collection in ['catalogItems','documentTemplates'] && member(cid);
   }
  }
 }
}
